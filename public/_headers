# Cloudflare Pages Caching & Security Headers
# Edge CDN Cache Rules for High Performance & Zero Server Cost

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=()

# Immutable Fingerprinted Assets (Vite Bundles)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker: Always revalidate to ensure immediate PWA updates
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript

# Web App Manifest: Edge cached for 24 hours with client-side revalidation
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/manifest+json

# Brand Icons and Favicons: Cached for 7 days
/favicon.ico
  Cache-Control: public, max-age=604800, immutable
/favicon.svg
  Cache-Control: public, max-age=604800, immutable
/icon-*.png
  Cache-Control: public, max-age=604800, immutable
/icons/*
  Cache-Control: public, max-age=604800, immutable

# Notification and Chime Audio Assets
/chime.wav
  Cache-Control: public, max-age=604800, immutable

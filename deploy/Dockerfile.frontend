# ==============================================================================
# MyArea24 — Production Multi-Stage Frontend Dockerfile (Vite React + Nginx)
# Builds high-performance production bundles and serves them via Nginx Alpine
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Stage
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Install package dependencies
COPY package*.json ./
RUN npm ci

# Copy client source code
COPY . .

# Build production bundle with Vite into /app/dist
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Runtime Web Server
# ------------------------------------------------------------------------------
FROM nginx:alpine AS runner

# Remove default static pages
RUN rm -rf /usr/share/nginx/html/*

# Copy built artifacts from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy production Nginx reverse proxy and caching configuration
COPY deploy/nginx/production.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Health check verifying that Nginx is serving the index.html page
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -q -O - http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

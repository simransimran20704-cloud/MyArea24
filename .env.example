# ==============================================================================
# MyArea24 Environment Configuration Template
# ==============================================================================
# DO NOT commit real secrets or production keys to source control.
# Copy this file to '.env' and populate your local credentials.

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME=MyArea24
LOG_LEVEL=INFO
DEBUG=true

# Allowed CORS Origins (W3C Fetch compliant list or comma-separated string)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","https://aidivi265.github.io"]

# Database Connection URL
# For local development without Postgres: sqlite:///./myarea24.db
# For production Supabase PostgreSQL (Connection Pooler port 6543 recommended for Vercel):
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./myarea24.db
DB_POOL_CLASS=NullPool

# Supabase Cloud & Media Storage Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=merchant-media
SUPABASE_DOCUMENTS_BUCKET=merchant-documents

# ==============================================================================
# Authentication & Indian SMS OTP (TRAI DLT Registered) / Email
# ==============================================================================
# In production in India, OTPs are sent via TRAI DLT compliant SMS gateways.
# 1. Register on a DLT portal (Jio DLT / Vilpower / PingConnect / Airtel DLT)
# 2. Get your 19-digit Principal Entity ID (PE ID) & approved 6-character Header (e.g. MYAR24)
# 3. Get your 19-digit Content Template ID for OTP verification messages
SMS_PROVIDER=auto
SMS_SENDER_ID=MYAR24
DLT_ENTITY_ID=
DLT_TEMPLATE_ID=
SMS_STRICT_PRODUCTION=false

# Fast2SMS (India) - https://www.fast2sms.com
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=dlt

# MSG91 (India) - https://msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=MYAR24

# Textlocal India - https://www.textlocal.in
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER=MYAR24

# Twilio (Fallback international transit)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Fill in your SMTP details (e.g., Gmail App Password, AWS SES, SendGrid, etc.)
# If left blank, OTPs will run in DEV MODE (logged in console and response)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@myarea24.in
SMTP_TLS=true
OTP_DEV_MODE=true

# JWT Secret for Session Authentication
JWT_SECRET_KEY=myarea24_local_development_secret_key_2026
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google Gemini AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Sarvam AI — Indian language TTS, Speech-to-Text, Translation
# Get your free API key at: https://dashboard.sarvam.ai
# Used for: Hindi voice input in AI assistant, text-to-speech for alerts
SARVAM_API_KEY=
SARVAM_API_BASE_URL=https://api.sarvam.ai

# Google Maps Platform Demo / Live Key
GOOGLE_MAPS_API_KEY=

# Resend Transactional Email Key
RESEND_API_KEY=

# Weather Provider Credentials
WEATHERAPI_API_KEY=
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
OPENWEATHERMAP_API_KEY=

# Fuel Price Provider (API Mitra)
API_MITRA_API_KEY=

# Traffic Provider Configuration (TomTom Primary)
TRAFFIC_PROVIDER=tomtom
TOMTOM_API_KEY=
TOMTOM_TRAFFIC_BASE_URL=https://api.tomtom.com/traffic/services/5

# Optional Fallback (HERE Traffic)
HERE_API_KEY=
HERE_TRAFFIC_BASE_URL=https://data.traffic.hereapi.com/v7

# NDMA SACHET CAP Feed URL
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_MAX_ITEMS_PER_POLL=20

# Air Quality Provider Configuration (OpenAQ v3 CPCB Aggregator / data.gov.in)
# Obtain a free OpenAQ API key from https://openaq.org
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
DATA_GOV_IN_API_KEY=
AQI_POLL_INTERVAL_MINUTES=60
AQI_MAX_STATION_DISTANCE_KM=15.0
AQI_OBSERVATION_MAX_AGE_MINUTES=180

# Ingestion Worker Settings
INGESTION_ENABLED=false
WEATHER_POLL_INTERVAL_MINUTES=30
TRAFFIC_POLL_INTERVAL_MINUTES=10
SACHET_POLL_INTERVAL_MINUTES=15
HTTP_TIMEOUT_SECONDS=10.0
MAX_HTTP_RETRIES=3

# Deterministic Correlation Rule Configuration (Scenario D: Monsoon Commute)
RULE_RAIN_THRESHOLD_MM_PER_HR=8.0
RULE_JAM_FACTOR_THRESHOLD=6.5
RULE_DELAY_THRESHOLD_SECONDS=900
RULE_SPATIAL_RADIUS_KM=5.0
RULE_EVALUATION_WINDOW_START=17:30
RULE_EVALUATION_WINDOW_END=20:30
RULE_SIGNAL_MAX_AGE_MINUTES=60
RULE_TIMEZONE=Asia/Kolkata

# Pilot Locations (JSON array of {name, lat, lon})
# Default: 5 key commuter nodes in Delhi-NCR and Bengaluru
PILOT_LOCATIONS='[{"name": "Delhi AIIMS Ring Road", "lat": 28.5672, "lon": 77.2100}, {"name": "Delhi Connaught Place", "lat": 28.6304, "lon": 77.2177}, {"name": "Delhi Rohini Sector 11", "lat": 28.7144, "lon": 77.1197}, {"name": "Bengaluru Silk Board", "lat": 12.9176, "lon": 77.6233}, {"name": "Bengaluru Indiranagar", "lat": 12.9784, "lon": 77.6408}]'

# Pilot Traffic Bounding Box (minLon, minLat, maxLon, maxLat)
# Default: Delhi South / Central Ring Road corridor
PILOT_TRAFFIC_BBOX=77.1500,28.5200,77.2600,28.6200

# ==============================================================================
# Client Public Environment Variables (Only public identifiers starting with VITE_)
# Sensitive third-party API keys (WeatherAPI, TomTom, OpenAQ, Sarvam, Gemini)
# MUST remain on the FastAPI backend above and NEVER be prefixed with VITE_.
# ==============================================================================

# Supabase Public Client Credentials (Safe for browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API Base URL (optional for relative dev proxy; set to full URL for remote backend)
VITE_API_BASE_URL=

# Razorpay Payment Gateway Public Key ID (Safe for client checkout.js)
# Get test key at: https://dashboard.razorpay.com/
VITE_RAZORPAY_KEY_ID=rzp_test_MyArea24SimKey


# Residential Benchmark API (Global Property Metrics)
GPM_API_KEY=gpm_free_your_api_key_here
GPM_API_BASE_URL=https://globalpropertymetrics.com/api
